# Счётчик визитов (Upstash Redis REST API).
# Скопируйте в .env.local для разработки или задайте в Vercel → Settings → Environment Variables.
#
# Как взять значения:
# 1) https://console.upstash.com → Redis → создать базу → вкладка «REST API»
# 2) Скопировать UPSTASH_REDIS_REST_URL и UPSTASH_REDIS_REST_TOKEN
#
# ВАЖНО: в Vercel включите переменные для среды Production (и Preview при необходимости).
# После добавления или изменения переменных сделайте Redeploy.

UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=Axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Альтернатива (если подключали Vercel KV и в проекте уже есть эти имена):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Опционально: ключевая ставка по умолчанию для калькулятора досрочного погашения
# DEFAULT_KEY_RATE_PERCENT=21
