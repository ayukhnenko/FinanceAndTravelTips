# Счётчик визитов и таблица настроек (Supabase).
# Скопируйте в .env.local для разработки или задайте в Vercel → Settings → Environment Variables.
#
# Как взять значения:
# 1) Supabase Project Settings → API
# 2) Скопировать Project URL (SUPABASE_URL) и Secret key (SUPABASE_SECRET_KEY)
#
# ВАЖНО: в Vercel включите переменные для среды Production (и Preview при необходимости).
# После добавления или изменения переменных сделайте Redeploy.

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Для обратной совместимости можно оставить старую переменную:
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Таймаут чтения/записи таблицы настроек (мс), по умолчанию 2500
# SETTINGS_TIMEOUT_MS=2500
# Таймаут операций с БД для счётчика визитов (мс), по умолчанию 2500
# DB_TIMEOUT_MS=2500
# Пароль для входа в админ-раздел (обязательно задать в Production)
# ADMIN_PASSWORD=change_me
#
# Метка стенда перед названием приложения (например DEV или Preview).
# PROD не показывается в шапке и на главной; в админке отображается красным.
# NEXT_PUBLIC_APP_STAND_LABEL=DEV
#
# Секрет для Vercel Cron (GET /api/cron/sync-key-rate, GET /api/cron/sync-deposits).
# Vercel автоматически шлёт Authorization: Bearer <CRON_SECRET>.
# Задайте только в Production; cron не запускается на preview.
# CRON_SECRET=long_random_string
#
# Для вкладов из Google Sheets выполните SQL из supabase/schema.sql
# (таблицы app_settings_params и app_deposit_offers).
#
# Для инициализации таблиц в Supabase выполните SQL из файла supabase/schema.sql
# (в том числе app_users, app_email_verification_tokens и app_password_reset_tokens для личного кабинета).
#
# Resend — подтверждение e-mail и восстановление пароля.
# 1) Создайте API key в https://resend.com/api-keys
# 2) Добавьте и верифицируйте домен отправителя в Resend → Domains
# 3) RESEND_FROM — адрес From, например: Калькуляторы <noreply@yourdomain.com>
# Для тестов Resend можно использовать onboarding@resend.dev (только на свой e-mail).
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Калькуляторы <onboarding@resend.dev>
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# EMAIL_VERIFICATION_TTL_MS=86400000
# EMAIL_VERIFICATION_COOLDOWN_MS=60000
# PASSWORD_RESET_TTL_MS=3600000
# PASSWORD_RESET_COOLDOWN_MS=300000
